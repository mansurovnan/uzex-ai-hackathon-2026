# UZEX AI Hackathon 2026 Environment Configuration

# Application
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0

# Database
DB_PATH=dataset/processed/uzex_data.duckdb

# LLM Providers (Configure at least one)
# Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API (Optional alternative)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Agent Settings
MAX_QUERY_LIMIT=100
QUERY_TIMEOUT_SECONDS=10
DEFAULT_LANGUAGE=uz
